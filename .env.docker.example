# Base image mirrors used when Docker Hub is unreachable.
BACKEND_PYTHON_IMAGE=mirror.ccs.tencentyun.com/library/python:3.11-slim
FRONTEND_NODE_IMAGE=mirror.ccs.tencentyun.com/library/node:22-alpine
FRONTEND_NGINX_IMAGE=mirror.ccs.tencentyun.com/library/nginx:1.27-alpine
FRONTEND_PUBLIC_PORT=8080

# Python package mirror used during backend image build.
BACKEND_PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
BACKEND_PIP_TRUSTED_HOST=mirrors.cloud.tencent.com
BACKEND_AMAP_MCP_SERVER_VERSION=0.1.11
