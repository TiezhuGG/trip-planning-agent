APP_NAME=trip-planning-agent
APP_ENV=production
CORS_ORIGINS=["http://101.34.87.128:8080"]

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_BACKUP_API_KEY=
OPENAI_BACKUP_BASE_URL=
OPENAI_BACKUP_MODEL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
OPENAI_TRUST_ENV=false
OPENAI_FAST_MODE=false

# 高德前端地图 JS SDK 配置
# 这里请填写 Web端(JS API) Key，而不是 Web服务 Key
AMAP_API_KEY=
# 如果你的 JS API Key 开启了安全校验，这里填写安全密钥
AMAP_SECURITY_JS_CODE=

# sugarforever/amap-mcp-server 启动配置
# 生产环境建议在镜像构建阶段预装 amap-mcp-server，并直接执行已安装命令（避免运行时动态拉包超时）
AMAP_MCP_COMMAND=amap-mcp-server
AMAP_MCP_ARGS=["stdio"]
# 这里的 AMAP_MAPS_API_KEY 应填写高德 Web服务 Key，供 MCP Server 调用地图服务
AMAP_MCP_ENV={"AMAP_MAPS_API_KEY":""}
AMAP_MCP_INHERIT_PROXY_ENV=false

# 默认工具名；系统也会在运行时尝试自动识别实际工具名
AMAP_MCP_TOOL_POI_SEARCH=maps_text_search
AMAP_MCP_TOOL_ROUTE_PLAN=maps_direction_driving_by_address
AMAP_MCP_TOOL_WEATHER=maps_weather
AMAP_MCP_TIMEOUT_SECONDS=20
ENABLE_MOCK_MCP=false
